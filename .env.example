TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
OPENAI_API_KEY=
TEXT_MODEL=gpt-4.1-mini
TEXT_MODEL_BASE_URL=https://api.openai.com/v1
# The agent's own Chrome (start it with `uv run jev chrome`) and its own Browser Harness daemon.
BU_CDP_URL=http://127.0.0.1:9333
BU_NAME=jev
BH_TELEMETRY=0
BH_TAB_MARKER=0
# 1 adds /api/debug with each task's recent steps.
JEV_DEBUG=0
# Pre-approval ("don't ask, under ₹N"): shadow (the default) always asks, even when your message said not to.
# JEV_PREAUTH=on
# Where the profile, traces, bench reports, and the agent Chrome's data live (default ~/.jev).
# JEV_HOME=/Users/you/.jev
# One tunnel (ngrok) allowed to reach the chat, besides 127.0.0.1.
# JEV_PUBLIC_ORIGIN=https://example.ngrok.app
