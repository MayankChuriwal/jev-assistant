TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
OPENAI_API_KEY=
TEXT_MODEL=gpt-4.1-mini
TEXT_MODEL_BASE_URL=https://api.openai.com/v1
# The agent's own Chrome (start it with `uv run jev chrome`) and its own Browser Harness daemon.
BU_CDP_URL=http://127.0.0.1:9333
BU_NAME=jev
BH_TELEMETRY=0
BH_TAB_MARKER=0
# 1 adds /api/debug with each task's recent steps.
JEV_DEBUG=0
# Pre-approval ("don't ask, under ₹N"): shadow (the default) always asks, even when your message said not to.
# JEV_PREAUTH=on
# Standing approvals (saved "don't ask next time" rules) also need JEV_PREAUTH=on.
# Where traces, bench reports, and the agent Chrome's data live (default ~/.jev).
# JEV_HOME=/Users/you/.jev
# One tunnel (ngrok) allowed to reach the chat, besides 127.0.0.1.
# JEV_PUBLIC_ORIGIN=https://example.ngrok.app
# Memory: the Postgres database (default postgresql:///jev, made on first start) and the key that encrypts your IDs.
# The first start writes JEV_MEMORY_KEY here when no ID is stored yet. Keep it: with IDs stored and no key, the chat and
# `jev run` refuse to start; a wrong key makes those IDs unreadable, and they are asked for again.
# JEV_DATABASE_URL=postgresql:///jev
# JEV_MEMORY_KEY=
# Tests make a throwaway database through this server (default postgresql:///postgres). Export it in your shell:
# tests never read .env.
# JEV_TEST_DATABASE_URL=postgresql:///postgres
